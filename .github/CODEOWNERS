/packages/petpack-schema/         @person-b
/apps/desktop/src/renderer/       @person-b
/DESIGN.md                        @person-b

# ---------- 人C：平台交易线 ----------
/services/api/                    @person-c
/services/ai-gateway/             @person-c
/packages/pricing-sdk/            @person-c

